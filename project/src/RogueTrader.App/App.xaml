<Application x:Class="RogueTrader.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RogueTrader.App.Views">
  <Application.Resources>
    <ResourceDictionary>

      <!-- ═══════════════════ Палитра ═══════════════════ -->
      <Color x:Key="BgColor">#101319</Color>
      <Color x:Key="PanelColor">#191D26</Color>
      <Color x:Key="PanelColor2">#212734</Color>
      <Color x:Key="PanelColor3">#2B3242</Color>
      <Color x:Key="BorderColor">#333B4C</Color>
      <Color x:Key="BorderSoft">#262D3A</Color>
      <Color x:Key="TextColor">#E9EDF5</Color>
      <Color x:Key="TextDim">#9AA4B8</Color>
      <Color x:Key="TextFaint">#6B7488</Color>
      <Color x:Key="GoldColor">#D4AF37</Color>
      <Color x:Key="GoldDim">#8A7326</Color>
      <Color x:Key="CrimsonColor">#8C1C13</Color>
      <Color x:Key="CrimsonHover">#A6291C</Color>
      <Color x:Key="OkColor">#3F9A5C</Color>
      <Color x:Key="WarnColor">#D08A26</Color>
      <Color x:Key="ErrorColor">#D0503C</Color>
      <Color x:Key="SelColor">#2E4A73</Color>

      <SolidColorBrush x:Key="BgBrush"        Color="{StaticResource BgColor}" />
      <SolidColorBrush x:Key="PanelBrush"     Color="{StaticResource PanelColor}" />
      <SolidColorBrush x:Key="Panel2Brush"    Color="{StaticResource PanelColor2}" />
      <SolidColorBrush x:Key="Panel3Brush"    Color="{StaticResource PanelColor3}" />
      <SolidColorBrush x:Key="BorderBrush"    Color="{StaticResource BorderColor}" />
      <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoft}" />
      <SolidColorBrush x:Key="TextBrush"      Color="{StaticResource TextColor}" />
      <SolidColorBrush x:Key="TextDimBrush"   Color="{StaticResource TextDim}" />
      <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaint}" />
      <SolidColorBrush x:Key="GoldBrush"      Color="{StaticResource GoldColor}" />
      <SolidColorBrush x:Key="GoldDimBrush"   Color="{StaticResource GoldDim}" />
      <SolidColorBrush x:Key="CrimsonBrush"   Color="{StaticResource CrimsonColor}" />
      <SolidColorBrush x:Key="OkBrush"        Color="{StaticResource OkColor}" />
      <SolidColorBrush x:Key="WarnBrush"      Color="{StaticResource WarnColor}" />
      <SolidColorBrush x:Key="ErrorBrush"     Color="{StaticResource ErrorColor}" />
      <SolidColorBrush x:Key="SelBrush"       Color="{StaticResource SelColor}" />

      <!-- ═══════════════════ Базовые стили ═══════════════════ -->
      <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="UseLayoutRounding" Value="True" />
      </Style>

      <!--
        Фон задаём не только на Window: часть контейнеров (вложенные окна,
        Popup) наследуют фон не от окна, и без явного значения проявляется
        системный белый.
      -->
      <Style TargetType="Grid">
        <Setter Property="Background" Value="Transparent" />
      </Style>

      <Style TargetType="Border" />

      <!--
        Базовый TextBlock намеренно без TextWrapping и без VerticalAlignment:
        иначе подпись кнопки «+10» переносится на две строки, а мелкие
        подписи прижимаются к верху. Перенос включают стили ниже.
      -->
      <Style TargetType="TextBlock" />

      <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <Style x:Key="Faint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <Style x:Key="SubHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <Style x:Key="Big" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
      </Style>

      <!-- ═══════════════════ Поля ввода ═══════════════════ -->
      <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource GoldBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource SelBrush}" />
        <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <!--
                Padding рамкой НЕ задаём: TextBox сам копирует его в
                PART_ContentHost. Если задать в обоих местах, отступ
                получается двойным и поле вдвое выше нужного.
              -->
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="4">
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                              views:SmoothScroll.Enabled="True" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel3Brush}" />
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ═══════════════════ Кнопки ═══════════════════ -->
      <Style x:Key="ButtonBase" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="13,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ButtonBase">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel3Brush}" />
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldDimBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}" />

      <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource CrimsonBrush}" />
        <Setter Property="BorderBrush" Value="#B03A2A" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ButtonBase">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                      CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#A6291C" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="Padding" Value="9,5" />
      </Style>

      <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
      </Style>

      <!--
        Маленькая кнопка-шаг рядом с ячейкой: «−» и «+» у «Базы» и «Правок».
      -->
      <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
      </Style>

      <!--
        Кнопки окна в собственной полосе приложения: без рамки, при наведении
        подсвечиваются панелью, «Закрыть» — багровым.
      -->
      <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ButtonBase">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel2Brush}" />
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!--
        Кнопки масштаба в полосе окна: «−», значение в процентах и «+».
        Живут в полосе окна, которая не масштабируется, поэтому размер
        кнопок не меняется при увеличении интерфейса.
      -->
      <Style x:Key="ZoomButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
      </Style>

      <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ButtonBase">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource CrimsonBrush}" />
                  <Setter Property="Foreground" Value="White" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!--
        Раскрывающийся блок с подробностями: описание умения или таланта,
        эффекты, требования. Заголовок — тихий, сам блок — без рамки.
      -->
      <Style x:Key="DetailsExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="0,4,0,0" />
        <Setter Property="FontSize" Value="12" />
      </Style>

      <!-- ═══════════════════ Ползунки и списки ═══════════════════ -->
      <!-- ═══════════════════ Фокус ═══════════════════ -->
      <!--
        Стандартный адорнер фокуса WPF рисует под системными цветами
        (светло-голубая заливка с синей обводкой) и выглядит чужеродно.
        Заменяем его тонкой золотой пунктирной рамкой.
        Объявлен здесь — до первого использования в ListBoxItem.
      -->
      <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Rectangle Margin="-2" RadiusX="4" RadiusY="4" Fill="Transparent"
                         Stroke="{StaticResource GoldBrush}" StrokeThickness="1"
                         StrokeDashArray="3 2" SnapsToDevicePixels="True"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource BgBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <!--
          Виртуализация обязательна: списки длинные (143 умения, 61 психический
          приём, 665 предметов), а без неё WPF создаёт и измеряет все строки
          сразу — открытие раздела «Психика» занимало 4–6 секунд, интерфейс
          в это время не отвечал.
        -->
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <!--
          Прокрутка в пикселях, но с виртуализацией. Обычно виртуализация
          требует прокрутки по элементам (CanContentScroll="True"), и тогда
          колесо прыгает по целым карточкам: смещение округляется до края
          элемента, и плавной анимации не выходит.
          VirtualizingStackPanel умеет считать смещение в пикселях
          (VirtualizingPanel.ScrollUnit="Pixel"): виртуализация остаётся,
          а список катится плавно, как страница в браузере.
          Свойство присоединённое и задаётся самому списку — панель читает
          его со своего ItemsControl.
        -->
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <!-- Свой шаблон: системный ListBox заливал пустое поле белым. -->
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBox">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}" CornerRadius="6">
                <!--
                  CanContentScroll не задан жёстко: режим прокрутки берётся
                  из ScrollViewer.CanContentScroll у самого списка (см. стиль
                  выше). Смещение считается в пикселях — за это отвечает
                  VirtualizingStackPanel со ScrollUnit="Pixel" (см. стиль выше).
                -->
                <ScrollViewer x:Name="PART_Scroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                              views:SmoothScroll.Enabled="True"
                              Focusable="False">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!-- Свой шаблон: системный ListBoxItem подсвечивал бы пункт
             светло-голубым цветом выделения Windows. -->
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                      Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                <ContentPresenter TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel2Brush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ═══════════════════ ScrollBar (тёмная тема) ═══════════════════ -->
      <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Thumb">
              <Border x:Name="Bd" Background="#3C4658" CornerRadius="4" Margin="3" />
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldDimBrush}" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Cursor="Hand"
                                      Background="Transparent" BorderThickness="0" Opacity="0" />
                  </Track.IncreaseRepeatButton>
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Cursor="Hand"
                                      Background="Transparent" BorderThickness="0" Opacity="0" />
                  </Track.DecreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter Property="Height" Value="12" />
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                  <Grid Background="Transparent">
                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                      <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                      <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False" Cursor="Hand"
                                      Background="Transparent" BorderThickness="0" Opacity="0" />
                      </Track.IncreaseRepeatButton>
                      <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False" Cursor="Hand"
                                      Background="Transparent" BorderThickness="0" Opacity="0" />
                      </Track.DecreaseRepeatButton>
                    </Track>
                  </Grid>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- ═══════════════════ Разделы (боковое меню) ═══════════════════ -->
      <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TabItem">
              <Border x:Name="Bd" Background="Transparent" Padding="16,6"
                      BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderSoftBrush}"
                      SnapsToDevicePixels="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="Mark" Grid.Column="0" Background="Transparent" CornerRadius="2"/>
                  <ContentPresenter x:Name="Head" Grid.Column="1" ContentSource="Header"
                                    TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel2Brush}" />
                  <Setter TargetName="Mark" Property="Background" Value="{StaticResource GoldBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel2Brush}" />
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>

      <!-- ═══════════════════ ComboBox (полностью своя тема) ═══════════════════ -->
      <Style x:Key="ComboToggleButton" TargetType="ToggleButton">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <!--
                Вложенный ToggleButton-«коврик» здесь НЕ нужен и был вредным:
                без явного шаблона он рисовался системной хромией (светло-синий
                фон с серой рамкой), и при наведении поверх тёмной темы появлялось
                «голубое» пятно. Клики и так ловит эта кнопка на весь элемент,
                а текст выбранного значения объявлен IsHitTestVisible=False.
              -->
              <Border x:Name="Bd" Background="{StaticResource Panel2Brush}"
                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="26" />
                  </Grid.ColumnDefinitions>
                  <Path Grid.Column="1" Data="M 0 0 L 4 4.5 L 8 0" Stroke="{StaticResource TextDimBrush}"
                        StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldDimBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBoxItem">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      Padding="{TemplateBinding Padding}" CornerRadius="3"
                      SnapsToDevicePixels="True">
                <ContentPresenter x:Name="Cp"
                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel3Brush}" />
                  <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
              <Grid>
                <ToggleButton Style="{StaticResource ComboToggleButton}" Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                  IsHitTestVisible="False"
                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                       IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                       PopupAnimation="Fade" MinWidth="{TemplateBinding ActualWidth}"
                       MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <Border Background="{StaticResource Panel2Brush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1" CornerRadius="5" Margin="0,3,0,0" Padding="4">
                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  views:SmoothScroll.Enabled="True">
                      <ItemsPresenter />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.5" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ═══════════════════ Флажок ═══════════════════ -->
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <StackPanel Orientation="Horizontal" Background="Transparent">
                <Border x:Name="Box" Width="17" Height="17" CornerRadius="3"
                        Background="{StaticResource Panel2Brush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center" SnapsToDevicePixels="True">
                  <Path x:Name="Tick" Data="M 2 6 L 5.5 9.5 L 11 3" Stroke="{StaticResource GoldBrush}"
                        StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                        Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GoldDimBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Panel3Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="MaxWidth" Value="460" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToolTip">
              <Border Background="{TemplateBinding Background}" CornerRadius="5"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="12">
                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ═══════════════════ Прокрутка ═══════════════════ -->
      <Style x:Key="Scroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="PanningMode" Value="VerticalOnly" />
        <!--
          False, а не True: страница — это StackPanel, и при прокрутке по
          элементам он измерялся бы по высоте окна и обрезался. Плавной
          прокрутке нужны пиксели, а у списков своя прокрутка (стиль ListBox),
          где CanContentScroll="True" и работает виртуализация.
        -->
        <Setter Property="CanContentScroll" Value="False" />
        <!-- Плавная прокрутка колесом вместо прыжков на «щелчок» -->
        <Setter Property="views:SmoothScroll.Enabled" Value="True" />
      </Style>

      <Style x:Key="SmoothScroll" TargetType="ScrollViewer" BasedOn="{StaticResource Scroll}" />

      <!-- ═══════════════════ Псевдонимы для кода и шаблонов ═══════════════════ -->
      <SolidColorBrush x:Key="MutedBrush"   Color="{StaticResource TextDim}" />
      <SolidColorBrush x:Key="AccentBrush"  Color="{StaticResource GoldColor}" />
      <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarnColor}" />
      <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />

      <views:BoolToBadgeConverter x:Key="BoolToBadge" />
      <views:CountToVisibilityConverter x:Key="HasCount" />
      <views:CountToVisibilityConverter x:Key="NoCount" Invert="True" />
      <views:BoolToVisibilityConverter x:Key="BoolVis" />
      <views:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True" />
      <views:StringVisibilityConverter x:Key="StringVis" />
      <views:ShortTextConverter x:Key="ShortText" />

      <!--
        ═══════════════════ Выпадающие списки с описанием ═══════════════════
        Пункт списка показывает название, описание из книги и игромеханические
        бонусы — вариант можно оценить до выбора. В закрытом списке остаётся
        только название (SelectionBoxItemTemplate).
      -->
      <DataTemplate x:Key="ChoiceItemTemplate">
        <StackPanel Margin="0,0,0,2">
          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ShortDescription}" Style="{StaticResource Faint}"
                     Margin="0,3,0,0"
                     Visibility="{Binding ShortDescription, Converter={StaticResource StringVis}}"/>
          <TextBlock Text="{Binding ShortBonuses}" Style="{StaticResource Muted}"
                     Margin="0,3,0,0" Foreground="{StaticResource GoldBrush}"
                     Visibility="{Binding ShortBonuses, Converter={StaticResource StringVis}}"/>
        </StackPanel>
      </DataTemplate>

      <DataTemplate x:Key="ChoiceNameTemplate">
        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
      </DataTemplate>

      <!--
        Список наград варианта жизненного пути — общий для всех разделов.
      -->
      <Style x:Key="GrantList" TargetType="ItemsControl">
        <Setter Property="Margin" Value="8,8,0,0" />
        <Setter Property="ItemTemplate">
          <Setter.Value>
            <DataTemplate>
              <Border Background="{StaticResource Panel2Brush}" CornerRadius="3"
                      Padding="10,5" Margin="0,0,0,4">
                <TextBlock Text="{Binding}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
              </Border>
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!--
        Выпадающий список с подробным пунктом: в раскрытом списке видно
        описание и бонусы варианта, в закрытом — только название.
        Отдельный шаблон нужен потому, что SelectionBoxItemTemplate у
        ComboBox доступно только для чтения.
      -->
      <!--
        Компактная кнопка для шапки окна: на экране 1280×720 обычные кнопки
        не помещались в одну строку и шапка вырастала на треть экрана.
      -->
      <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,5,5" />
      </Style>

      <Style x:Key="RichChoice" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="ItemTemplate" Value="{StaticResource ChoiceItemTemplate}" />
        <Setter Property="MaxDropDownHeight" Value="380" />
        <!--
          Без виртуализации: при переработке контейнеров WPF оставлял
          в списке «призрачную» обрезанную строку. Списки короткие:
          виды, роды занятий, разделы жизненного пути.
        -->
        <Setter Property="ItemsPanel">
          <Setter.Value>
            <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
              <Grid>
                <ToggleButton Style="{StaticResource ComboToggleButton}" Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                  IsHitTestVisible="False"
                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{StaticResource ChoiceNameTemplate}" />
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                       IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                       PopupAnimation="Fade" MinWidth="{TemplateBinding ActualWidth}"
                       MaxHeight="{TemplateBinding MaxDropDownHeight}"
                       Opened="OnRichChoicePopupOpened" Closed="OnRichChoicePopupClosed">
                  <!--
                    Ширину списка ограничиваем: без этого длинное описание
                    варианта растягивает всплывающее окно за пределы экрана,
                    и текст не переносится, а уезжает вбок.
                  -->
                  <Border Background="{StaticResource Panel2Brush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1" CornerRadius="5" Margin="0,3,0,0" Padding="4"
                          MaxWidth="820">
                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  views:SmoothScroll.Enabled="True">
                      <ItemsPresenter/>
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.5" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>